---
// AsteroidsGame.astro - Main game component
import type { ScreenSize, GameMode, Difficulty } from '../lib/types/game-state.js';
import type { DisplayConfiguration } from '../lib/types/display.js';
import { CHARACTER_SETS } from '../lib/types/display.js';

// Props interface
export interface Props {
  width?: number;
  height?: number;
  characterMode?: 'ascii' | 'unicode';
  physicsMode?: GameMode;
  difficulty?: Difficulty;
  autoStart?: boolean;
  showControls?: boolean;
  onGameOver?: (score: number) => void;
  onLevelComplete?: (level: number) => void;
  onScoreChange?: (score: number) => void;
}

// Extract props with defaults
const {
  width = 80,
  height = 25,
  characterMode = 'ascii',
  physicsMode = 'traditional',
  difficulty = 'normal',
  autoStart = true,
  showControls = true,
  onGameOver,
  onLevelComplete,
  onScoreChange
} = Astro.props;

// Validate props
if (width <= 0 || height <= 0) {
  throw new Error('Width and height must be positive numbers');
}

// Create screen size configuration
const screenSize: ScreenSize = { width, height };

// Create display configuration
const displayConfig: DisplayConfiguration = {
  characterMode,
  characterSet: characterMode === 'ascii' ? CHARACTER_SETS.ascii : CHARACTER_SETS.unicode,
  colors: {
    background: '#000000',
    foreground: '#00FF00',
    accent: '#FFFF00',
    highlight: '#FF0000'
  },
  screenSize
};

// Generate unique component ID
const componentId = `asteroids-game-${Math.random().toString(36).substring(2, 11)}`;
---

<div class="asteroids-game-container" id={componentId}>
  <!-- Game canvas will be inserted here by JavaScript -->
  <div class="game-loading">
    <p>Loading Asteroids Game...</p>
    <p>Press any key to continue</p>
  </div>

  <!-- Controls help (optional) -->
  {showControls && (
    <div class="game-controls">
      <h3>Controls:</h3>
      <ul>
        <li><strong>W/↑</strong> - Thrust</li>
        <li><strong>A/←</strong> - Rotate Left</li>
        <li><strong>D/→</strong> - Rotate Right</li>
        <li><strong>Space</strong> - Shoot</li>
        <li><strong>P/Esc</strong> - Pause</li>
        <li><strong>R</strong> - Reset (when game over)</li>
        <li><strong>C</strong> - Toggle Characters (ASCII/Unicode)</li>
        <li><strong>M</strong> - Toggle Physics (Scrolling/Traditional)</li>
      </ul>
    </div>
  )}
</div>

<style>
  .asteroids-game-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background-color: #000;
    color: #00FF00;
    font-family: Monaco, "Lucida Console", "Courier New", monospace;
    border: 2px solid #00FF00;
    border-radius: 4px;
    position: relative;
  }

  .game-loading {
    text-align: center;
    padding: 2rem;
    font-size: 1.2em;
  }

  .game-loading p {
    margin: 0.5rem 0;
  }

  .game-controls {
    background-color: #001100;
    border: 1px solid #00FF00;
    border-radius: 4px;
    padding: 1rem;
    font-size: 0.9em;
    max-width: 600px;
  }

  .game-controls h3 {
    margin: 0 0 0.5rem 0;
    color: #FFFF00;
  }

  .game-controls ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.25rem;
  }

  .game-controls li {
    margin: 0;
  }

  .game-controls strong {
    color: #FFFF00;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .asteroids-game-container {
      padding: 0.5rem;
    }

    .game-controls ul {
      grid-template-columns: 1fr;
    }
  }

  /* Focus management for accessibility */
  .asteroids-game-container:focus-within {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
  }
</style>


<script>
console.log('[AsteroidsGame] Script starting...');

import { GameLoop } from '../lib/engine/game-loop.js';
import { PhysicsEngine } from '../lib/engine/physics.js';
import { CollisionSystem } from '../lib/engine/collision.js';
import { SimpleRenderer } from '../lib/engine/simple-renderer.js';
import { GameStateManager } from '../lib/engine/game-state.js';
import { InputHandler } from '../lib/engine/input.js';

console.log('[AsteroidsGame] Modules imported successfully');

// Component configuration
const componentId = document.querySelector('.asteroids-game-container')?.id || 'asteroids-game-default';
const config = {
  screenSize: {width: 80, height: 25},
  displayConfig: {
    characterMode: "ascii",
    characterSet: {
      spaceship: { up: "^", down: "v", left: "<", right: ">" },
      asteroid: { large: "O", small: "o" },
      projectile: "."
    },
    colors: {
      background: "#000000",
      foreground: "#00FF00",
      accent: "#FFFF00",
      highlight: "#FF0000"
    },
    screenSize: {width: 80, height: 25}
  },
  physicsMode: "traditional",
  difficulty: "normal",
  autoStart: true,
  componentId: componentId
};

// Game instance variables
let gameLoop = null;
let gameContainer = null;
let gameInitialized = false;

// Initialize game
async function initializeGame() {
  console.log('initializeGame called, already initialized?', gameInitialized);

  if (gameInitialized) {
    console.warn('Game already initialized, skipping!');
    return;
  }

  gameContainer = document.getElementById(config.componentId) || document.querySelector('.asteroids-game-container');
  if (!gameContainer) {
    console.error('Game container not found');
    return;
  }

  console.log('Starting game initialization...');
  try {
    // Create game systems
    const physics = new PhysicsEngine(config.screenSize, config.physicsMode);
    const collision = new CollisionSystem(config.screenSize.width, config.screenSize.height);
    const renderer = new SimpleRenderer(config.screenSize.width, config.screenSize.height);
    const gameState = new GameStateManager({
      screenSize: config.screenSize,
      gameMode: config.physicsMode,
      characterMode: config.displayConfig.characterMode,
      difficulty: config.difficulty
    });
    const input = new InputHandler(gameContainer);

    // Create game loop with normal settings
    gameLoop = new GameLoop(physics, collision, renderer, gameState, input, {
      targetFPS: 30,  // Normal FPS for smooth gameplay
      maxDeltaTime: 50,
      enableDebug: false
    });

    // Create game wrapper
    const gameWrapper = document.createElement('div');
    gameWrapper.className = 'game-wrapper';
    gameWrapper.style.cssText = 'position: relative; display: inline-block;';

    const gameElement = renderer.createDOMElement();
    gameElement.tabIndex = 0;
    gameWrapper.appendChild(gameElement);

    // Replace loading message
    const loadingElement = gameContainer.querySelector('.game-loading');
    if (loadingElement) {
      gameContainer.replaceChild(gameWrapper, loadingElement);
    }

    gameState.spawnAsteroidsForLevel(1);

    // Log initial state
    const initialState = gameState.getState();
    console.log('[AsteroidsGame] Initial game state:', {
      asteroids: initialState.objects.asteroids.length,
      projectiles: initialState.objects.projectiles.length,
      spaceship: initialState.objects.spaceship.alive,
      spaceshipPos: {
        x: initialState.objects.spaceship.position.x,
        y: initialState.objects.spaceship.position.y
      },
      spaceshipVel: {
        dx: initialState.objects.spaceship.velocity.dx,
        dy: initialState.objects.spaceship.velocity.dy
      }
    });

    if (config.autoStart) {
      console.log('[AsteroidsGame] Starting game loop with safety limits...');
      // Add a delayed start to ensure everything is ready
      setTimeout(() => {
        console.log('[AsteroidsGame] Actually starting game loop now');
        gameLoop.start();
      }, 100);
    }

    gameElement.focus();
    gameInitialized = true;
    console.log('Game initialization complete');

  } catch (error) {
    console.error('Failed to initialize Asteroids game:', error);
    const errorElement = document.createElement('div');
    errorElement.innerHTML = `<p>Error loading game: ${error.message}</p>`;
    errorElement.style.cssText = 'color: #FF0000; text-align: center; padding: 2rem;';

    const loadingElement = gameContainer.querySelector('.game-loading');
    if (loadingElement) {
      gameContainer.replaceChild(errorElement, loadingElement);
    }
  }
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initializeGame);
} else {
  setTimeout(initializeGame, 0);
}
</script>